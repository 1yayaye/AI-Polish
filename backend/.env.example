# AI-Polish 后端配置样例。复制为 .env 后按需修改；.env 是唯一配置来源（ADR-0005）。

# SQLite 数据库文件路径（相对于 backend/ 工作目录）
DATABASE_URL=sqlite:///data/app.db

# 管理端登录凭据（运营商后台）。三项任一为空则登录接口一律拒绝。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# JWT 签名密钥：随机长字符串，泄露等于管理端被接管
JWT_SECRET=change-me-to-a-long-random-string

# 管理端会话 cookie 的 Secure 标志：生产 HTTPS 保持 true；
# 仅本地纯 HTTP 调试改 false（浏览器豁免 localhost，但 curl/TestClient 不豁免）
ADMIN_COOKIE_SECURE=true

# 模型接入（openai 兼容，ADR-0005：运营商自备 key，仅存 .env，不落库不进后台）
# 三项齐备时应用启动润色 Worker；缺项则流水线不启动（本地开发可留空）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-operator-key
LLM_MODEL=your-model-name

# 僵尸恢复协议（app/recovery.py）：同一会话最多续跑次数（每次崩溃重启 +1，
# 超限兜底退款置 failed）；running 会话滞留多少秒无推进由巡检兜底退款；
# 巡检轮询间隔秒数
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_STUCK_AFTER_SECONDS=7200
RECOVERY_PATROL_INTERVAL_SECONDS=300

# 单次会话提交文本的字符数上限（len 口径）：资源护栏，超限创建请求 422。
# 调大时须同步调大 deploy/nginx/ai-polish.conf 的 client_max_body_size
MAX_SESSION_TEXT_CHARS=50000

# Word Formatter（M4）：单次格式化/预处理提交文本字符数上限（独立于会话的
# 5 万上限——排版对象是整篇文档，超限 413）；上传文件字节上限 MB（超限 413，
# 调大须同步调大 Nginx client_max_body_size）；docx 产物落盘目录（相对
# backend 工作目录）
MAX_WORD_TEXT_CHARS=200000
MAX_WORD_UPLOAD_MB=20
WORD_OUTPUT_DIR=data/word_jobs

# Word Formatter 保留期清理：completed/failed 任务超过保留期（秒）由巡检
# 协程连库行与落盘产物一并清理（queued/running 不碰）；巡检轮询间隔秒数
WORD_JOB_RETENTION_SECONDS=86400
WORD_JOB_PURGE_INTERVAL_SECONDS=300
