# AI-Polish 后端配置样例。复制为 .env 后按需修改；.env 是唯一配置来源（ADR-0005）。

# SQLite 数据库文件路径（相对于 backend/ 工作目录）
DATABASE_URL=sqlite:///data/app.db

# 管理端登录凭据（运营商后台）。三项任一为空则登录接口一律拒绝。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# JWT 签名密钥：随机长字符串，泄露等于管理端被接管
JWT_SECRET=change-me-to-a-long-random-string

# 管理端会话 cookie 的 Secure 标志：生产 HTTPS 保持 true；
# 仅本地纯 HTTP 调试改 false（浏览器豁免 localhost，但 curl/TestClient 不豁免）
ADMIN_COOKIE_SECURE=true

# 模型接入（openai 兼容，ADR-0005：运营商自备 key，仅存 .env，不落库不进后台）
# 三项齐备时应用启动润色 Worker；缺项则流水线不启动（本地开发可留空）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-operator-key
LLM_MODEL=your-model-name
